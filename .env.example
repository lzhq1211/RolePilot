# Copy this file to .env and fill only the providers you use.
# Do not put resume/JD/business context here; keep that in typed session files.

# Runtime defaults
RESUME_ROOT_DIR=.resume-sessions
DEFAULT_PROVIDER=openai-chat
DEFAULT_MODE=stub
DEFAULT_MODEL=

# Web Service: single-process local files by default, no database required.
# HOST=127.0.0.1
# PORT=4174
ROLEPILOT_STORAGE_MODE=local
ROLEPILOT_DATA_DIR=.rolepilot-data
ROLEPILOT_DEPLOYMENT_INSTANCE_ID=local-double-click
# Only needed when ROLEPILOT_STORAGE_MODE=supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ROLEPILOT_SOURCES_BUCKET=rolepilot-sources
ROLEPILOT_ARTIFACTS_BUCKET=rolepilot-artifacts
ROLEPILOT_EXPORTS_BUCKET=rolepilot-exports

# Safety and budget guardrails
MAX_LIVE_CALLS=3
MAX_AGENT_ATTEMPTS=1
AGENT_TIMEOUT_MS=600000
MAX_EXPLICIT_INPUT_BYTES=80000
MAX_OUTPUT_TOKENS=160000

# Current CLI-backed providers
CLAUDE_CODE_BIN=claude
OPENCODE_BIN=opencode
CODEX_BIN=codex

# Anthropic API provider (planned direct API adapter; stub/replay only until SDK adapter lands)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=160000
ANTHROPIC_EFFORT=high
ANTHROPIC_THINKING=adaptive
ANTHROPIC_PROMPT_CACHE=true

# OpenAI-compatible Chat provider (direct API adapter available)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=160000

# Web Worker Review 轮数，默认 2；调高会增加 Provider 调用和等待时间
ROLEPILOT_MAX_REVIEW_ROUNDS=2

# OpenAI Responses provider (planned direct API adapter)
OPENAI_RESPONSES_MODEL=

# Provider selection names for typed config:
# - openai-chat: direct OpenAI Chat Completions style provider; default direct API path
# - claude, opencode, codex: local CLI-backed providers with tool wrapper overhead
# - anthropic-api: reserved direct Anthropic Messages API provider; live mode not implemented yet
# - openai-responses: reserved OpenAI Responses style provider; live mode not implemented yet
